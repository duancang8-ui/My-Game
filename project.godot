; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MyGame"
config/description="《十日终焉》改编同人游戏 — 2.5D 等距规则怪谈轮回叙事"
run/main_scene="uid://bmainmenu1"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://src/scripts/save/game_state.gd"
SaveSystem="*res://src/scripts/save/save_system.gd"
SceneManager="*res://src/scripts/scene/scene_manager.gd"
DialogueDatabase="*res://src/scripts/dialogue/dialogue_database.gd"
Toast="*res://src/scripts/ui/toast.gd"
Notebook="*res://src/scripts/ui/notebook.gd"
QuestState="*res://src/scripts/quest/quest_state.gd"
AudioManager="*res://src/scripts/audio/audio_manager.gd"
TutorialHints="*res://src/scripts/ui/tutorial_hints.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

